# OrderFlow Studio configuration. PLACEHOLDERS ONLY: copy to .env and fill in locally.
# Never commit .env. Never paste real keys/tokens into issues, screenshots or chat.

# demo = offline synthetic feed (clearly labelled DEMO)
# kite = Zerodha Kite Connect (needs KITE_API_KEY + KITE_ACCESS_TOKEN)
# live = authenticated external quote batches via POST /api/ingest (needs MARKET_FEED_TOKEN)
MARKET_MODE=demo

# Keep localhost unless you deploy behind real authentication / a reverse proxy.
HOST=127.0.0.1
PORT=8000

# Zerodha Kite Connect (server-side only; access tokens expire daily)
KITE_API_KEY=
KITE_ACCESS_TOKEN=

# Shared secret for POST /api/ingest (MARKET_MODE=live only). Use a long random value.
MARKET_FEED_TOKEN=

# Where derived 20-session baselines are cached (gzip JSON; no candles, no credentials).
# Empty = ./.history_cache next to server.py
HISTORY_CACHE_DIR=

# Optional
# STRICT_TOP3_CONFIRMATION=false   # true: READY picks also need ACTIVE momentum with RVOL >= 1
# NSE_HOLIDAYS=2026-11-24,2026-12-25   # comma-separated YYYY-MM-DD exchange holidays
# FEED_FRESH_SECONDS=30              # max tick age for the LIVE badge
# PUBLISH_SECONDS=2                  # SSE dashboard snapshot interval
# DEMO_INTERVAL_SECONDS=4            # one virtual minute per demo step
# DEMO_START_MINUTE=135              # demo session starts at 09:15 + N minutes
# VIEWER_LABEL=VIEWER                # display label only, not authentication
